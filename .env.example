# Backend configuration
NODE_ENV=development
PORT=3000

# Database & auth
MONGODB_URI=mongodb://localhost:27017/mineazy
JWT_SECRET=replace-with-secure-random-string

# Cloudinary (required in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional-local dev)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Mineazy <noreply@mineazy.com>"

# URLs
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
ASSET_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File uploads
MAX_FILE_SIZE=5242880

# Frontend (Vite)
VITE_API_URL=http://localhost:3000
